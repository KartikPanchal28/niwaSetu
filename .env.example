# NiwasSetu Backend Environment Configuration
PORT=5000

# MongoDB Atlas Cloud Connection String
# Get your free M0 URI at: https://www.mongodb.com/atlas/database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/niwassetu?retryWrites=true&w=majority

# Google Gemini AI Model Integration (Free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:5000/api
