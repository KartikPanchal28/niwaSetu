# NiwasSetu Environment Configuration

# Server Port (Local Node.js Development)
PORT=5000

# MongoDB Atlas Cloud Connection String (Required on both Local & Vercel Dashboard)
# Get your free M0 cluster at: https://www.mongodb.com/atlas/database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/niwassetu?retryWrites=true&w=majority

# Google Gemini AI Model Integration (Required on both Local & Vercel Dashboard)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend API URL (Optional)
# - Default: Leave empty or omit! It defaults to `/api` which works seamlessly on Vercel Serverless Functions and local Vite proxy.
# - If hosting backend on external service (e.g. Render/Railway):
# VITE_API_URL=https://your-backend.onrender.com/api
